# Full corpus lives outside git (Releases / HF). Keep the sample fixture.
sources/*.jsonl
!sources/sample_laws.jsonl
sources/*.json
!sources/.gitkeep

# Scraper resume + large release artifacts (manifests under docs/examples/ are OK)
releases/*.jsonl
releases/*.sha256
!releases/.gitkeep
!docs/examples/*.manifest.json
!docs/examples/*.sha256
# Example manifests that point at unpublished private snapshots stay local:
releases/*.manifest.example.json
releases/laws_master.manifest.json

