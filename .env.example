# Copy to .env and fill in. Never commit real keys.
OPENROUTER_API_KEY=

# Optional: reuse an already-paid LanceDB (no re-embed / no copy).
# Example (sibling Masadir store): C:\iraqi-law-rag\lancedb
# IRAQI_RAG_DB_DIR=
# DB_DIR=   # short alias for IRAQI_RAG_DB_DIR

# Optional: disable law_cards / alias_lexicon routing (A/B vs seeds).
# IRAQI_RAG_NO_CARDS=1
# RAG_NO_CARDS=1   # short alias
# IRAQI_RAG_USE_CARDS=0
